# Vagrant runtime state (VMs, metadata - all centralized under vagrant/)
vagrant/

# Vagrant metadata (inside project subdirectories)
**/.vagrant/

# Ironhold - Secret Server installer binary (obtain separately)
Ironhold/installer/*.exe
Ironhold/installer/*.zip

# Thorngate - IVIG starter kit (obtain separately from IBM)
Thorngate/starter_kit/

# Thorngate - license key files (obtain separately)
Thorngate/license_files/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Bob context (local tool config, not part of the lab)
.bob/

# Setup guides - manual installation notes, not part of the lab repo
setup-guides/

# VS Code workspace file (local only)
*.code-workspace

# Vagrant debug logs (local only)
**/vagrant.log
