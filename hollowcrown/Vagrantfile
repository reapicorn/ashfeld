ENV["VAGRANT_DEFAULT_PROVIDER"] = "vmware_desktop"
ENV["VAGRANT_DOTFILE_PATH"]     = File.expand_path("../vagrant/hollowcrown/.vagrant", __dir__)

Vagrant.configure("2") do |config|

  config.vm.box = "bento/debian-12"
  config.vm.hostname = "hollowcrown"

  # ── Network ───────────────────────────────────────────────────────────────────
  # Private network for VM-to-VM communication (Ironhold, Thorngate, etc.)
  config.vm.network "private_network", ip: "10.10.10.30"

  # Fixed SSH port — prevents collisions when multiple lab VMs run simultaneously
  config.vm.network "forwarded_port", guest: 22, host: 2230, id: "ssh"

  # Port forwards — accessible from the host via localhost
  config.vm.network "forwarded_port", guest: 8080, host: 8030   # Web UI
  config.vm.network "forwarded_port", guest: 4000, host: 4000   # API

  # ── VMware Desktop (Fusion / Workstation) ─────────────────────────────────────
  config.vm.provider "vmware_desktop" do |vmware|
    vmware.vmx["memsize"]  = "1024"
    vmware.vmx["numvcpus"] = "1"
    vmware.gui = false
    vmware.clone_directory = File.expand_path("../vagrant/hollowcrown/vm", __dir__)
  end

  # ── Provisioning ──────────────────────────────────────────────────────────────
  # /vagrant is automatically shared — contains all project files
  config.vm.provision "shell", inline: <<-SHELL
    set -euo pipefail

    # Docker
    apt-get update -qq
    apt-get install -y -qq ca-certificates curl
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/debian/gpg \
      -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
      https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
      > /etc/apt/sources.list.d/docker.list
    apt-get update -qq
    apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-compose-plugin

    usermod -aG docker vagrant

    # Start the stack from the shared folder
    sudo -u vagrant bash -c '
      docker compose -f /vagrant/docker-compose.yml up --build -d
    '

    echo ""
    echo "======================================================"
    echo "  Hollowcrown — Ready"
    echo "======================================================"
    echo "  Web UI:  http://localhost:8030"
    echo "  API:     http://localhost:4000"
    echo "======================================================"
    echo ""
  SHELL

end
