# =============================================================
#  Stonewrit - Vagrantfile
#  IBM Verify Identity Governance (IVIG) on SLES 15 (Linux native)
#  Provider: VMware Desktop (vmware_desktop)
#
#  Usage:   vagrant up
#  Access:  https://localhost:9443/itim/console/main
#
#  Re-run individual steps from inside the VM:
#    /vagrant/scripts/install.sh base
#    /vagrant/scripts/install.sh base,postgres
# =============================================================

ENV["VAGRANT_DEFAULT_PROVIDER"] = "vmware_desktop"
ENV["VAGRANT_DOTFILE_PATH"]     = File.expand_path("../vagrant/stonewrit/.vagrant", __dir__)

# -- Pre-flight checks -----------------------------------------
installer_dir = File.expand_path("installer", __dir__)

{
  "IVIG installer zip (ivig_imsw_*.zip)"      => Dir.glob(File.join(installer_dir, "ivig_imsw_*.zip")).first,
  "ISVD installer directory (ivd-*/)"          => Dir.glob(File.join(installer_dir, "ivd-*")).select { |f| File.directory?(f) }.first,
  "IBM MQ tarball (*-IBM-MQ-LinuxX64.tar.gz)" => Dir.glob(File.join(installer_dir, "*-IBM-MQ-LinuxX64.tar.gz")).first,
  "IVIG license key (ivig_Enterprise_*.txt)"   => Dir.glob(File.join(installer_dir, "ivig_Enterprise_*.txt")).first,
}.each do |desc, path|
  if path.nil?
    abort "\n[Stonewrit] Missing required installer file: #{desc}\n" \
          "           Place it in stonewrit/installer/ before running vagrant up.\n"
  end
end

Vagrant.configure("2") do |config|

  config.vm.box      = "dstoliker/cured-sles15"
  config.vm.hostname = "stonewrit"

  # -- Network ------------------------------------------------------------------
  config.vm.network "private_network", ip: "10.10.10.40"

  config.vm.network "forwarded_port", guest: 22,   host: 2240,  id: "ssh"   # SSH
  config.vm.network "forwarded_port", guest: 9080, host: 9080               # IVIG console HTTP
  config.vm.network "forwarded_port", guest: 9443, host: 9443               # IVIG console HTTPS
  config.vm.network "forwarded_port", guest: 5432, host: 30543              # PostgreSQL
  config.vm.network "forwarded_port", guest: 389,  host: 30389              # LDAP
  config.vm.network "forwarded_port", guest: 636,  host: 30636              # LDAPS

  # -- VMware Desktop -----------------------------------------------------------
  config.vm.provider "vmware_desktop" do |vmware|
    vmware.vmx["displayName"] = "Stonewrit-IVIG"
    vmware.vmx["memsize"]     = "12288"
    vmware.vmx["numvcpus"]    = "4"
    vmware.vmx["gui"]         = "false"
    vmware.vmx["ethernet0.pcislotnumber"] = "160"
    vmware.vmx["ethernet1.pcislotnumber"] = "224"
    vmware.clone_directory = File.expand_path("../vagrant/stonewrit/vm", __dir__)
  end

  # -- Provisioning -------------------------------------------------------------
  config.vm.provision "shell",
    name:       "install",
    path:       "scripts/install.sh",
    args:       ["isvd"],
    privileged: true

end
