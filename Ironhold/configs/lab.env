# ============================================================
#  Secret Server Lab — Configuration
#  Edit these values before running "vagrant up"
# ============================================================

# SQL Server database password
SA_PASSWORD=Passw0rd!

# Secret Server initial admin credentials
SS_ADMIN_USER=admin
SS_ADMIN_PASS=Passw0rd!
SS_ADMIN_EMAIL=admin@lab.local

# Windows service account used by the IIS application pool
SS_SERVICE_USER=svc_ss
SS_SERVICE_PASS=Passw0rd!

# Database name
SS_DB_NAME=SecretServer
