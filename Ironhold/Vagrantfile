# =============================================================
#  Ironhold — Vagrantfile
#  Provider: VMware Desktop (Fusion / Workstation / Player)
#  Requires: vagrant-vmware-desktop plugin + VMware Utility Service
#
#  Usage:   vagrant up
#  Access:  https://localhost:8443/SecretServer (port-forwarded)
#           http://localhost:8080/SecretServer  (HTTP, port-forwarded)
#           https://10.10.10.10/SecretServer    (direct, from host or other VMs)
#  RDP:     localhost:53389  (vagrant / vagrant)
# =============================================================

ENV["VAGRANT_DEFAULT_PROVIDER"] = "vmware_desktop"
ENV["VAGRANT_DOTFILE_PATH"]     = File.expand_path("../vagrant/ironhold/.vagrant", __dir__)

# ── Pre-flight checks ─────────────────────────────────────────────────────────
installer_dir = File.expand_path("installer", __dir__)
[
  { file: "ISVPsetup.exe",  hint: "Download from the Delinea portal and place in Ironhold/installer/" },
  { file: "ss_update.zip",  hint: "Download from the Delinea portal and place in Ironhold/installer/" },
].each do |req|
  path = File.join(installer_dir, req[:file])
  unless File.exist?(path)
    abort "\n[Ironhold] Missing required file: installer/#{req[:file]}\n          #{req[:hint]}\n"
  end
end

Vagrant.configure("2") do |config|

  # Windows Server 2022 Evaluation (free, no license required)
  # Box source: https://app.vagrantup.com/gusztavvargadr/boxes/windows-server-2022-standard
  config.vm.box = "gusztavvargadr/windows-server-2022-standard"
  # hostname is set manually in the provisioner below to avoid a mid-provision reboot
  # config.vm.hostname = "ironhold"


  # ── Boot & WinRM timeouts (first boot includes sysprep; Hyper-V/VBS on host makes it slower)
  # After the hostname-change reboot, WinRM takes 2-3 min to recover.
  # retry_limit * retry_delay must cover that window.
  config.vm.boot_timeout     = 1800  # seconds to wait for the VM to boot
  config.winrm.timeout       = 60    # seconds per individual WinRM operation
  config.winrm.retry_limit   = 60    # number of WinRM connection retries
  config.winrm.retry_delay   = 15    # seconds between retries (60*15 = 15 min window)

  # Disable Vagrant's default /vagrant shared folder.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Mount the installer/ folder as a read-only shared folder.
  # The install.ps1 script copies files from here to C:\sslab\installer\.
  config.vm.synced_folder "installer", "C:\\sslab\\installer_src"

  # ── Network ───────────────────────────────────────────────────
  # VMware Desktop on Windows does not configure secondary adapters
  # automatically, so we declare the network and set the IP manually
  # via a provisioner below.
  config.vm.network "private_network", ip: "10.10.10.10", auto_config: false

  # Port forwarding: convenient shortcuts from the host
  config.vm.network "forwarded_port", guest: 80,   host: 8080   # HTTP
  config.vm.network "forwarded_port", guest: 443,  host: 8443   # HTTPS
  config.vm.network "forwarded_port", guest: 3389, host: 53389  # RDP

  # ── VMware Desktop provider (Fusion / Workstation / Player) ──
  config.vm.provider "vmware_desktop" do |vmware|
    vmware.vmx["displayName"]  = "SecretServer-Lab"
    vmware.vmx["memsize"]      = "4096"
    vmware.vmx["numvcpus"]     = "2"
    vmware.vmx["gui"]          = "false"   # Headless
    vmware.clone_directory = File.expand_path("../vagrant/ironhold/vm", __dir__)
    # Clipboard sharing (handy for copying credentials)
    vmware.vmx["isolation.tools.copy.disable"]  = "false"
    vmware.vmx["isolation.tools.paste.disable"] = "false"
    # VHV — needed when Hyper-V / VBS / WSL2 is active on the host.
    # Lets VMware run nested inside the Windows hypervisor without crashing Tools.
    vmware.vmx["vhv.enable"]             = "TRUE"
    vmware.vmx["vhv.allow"]              = "TRUE"
    vmware.vmx["featMask.vm.hv.capable"] = "Min:1"
    vmware.vmx["ethernet0.pcislotnumber"] = "192"
    vmware.vmx["ethernet1.pcislotnumber"] = "224"
  end

  # ── Configure private network adapter (IP only — no reboot risk) ─
  config.vm.provision "shell", run: "always", inline: <<-'SHELL'
    $up = Get-NetAdapter | Where-Object { $_.Status -eq "Up" }
    $adapter = $up | ForEach-Object {
      $gw = (Get-NetIPConfiguration -InterfaceIndex $_.InterfaceIndex
            ).IPv4DefaultGateway
      [PSCustomObject]@{ A = $_; GW = $gw }
    } | Where-Object { $_.GW -eq $null } |
      Select-Object -First 1 -ExpandProperty A

    if ($adapter) {
      $idx = $adapter.InterfaceIndex
      $cur = Get-NetIPAddress -InterfaceIndex $idx `
               -AddressFamily IPv4 -ErrorAction SilentlyContinue
      if (-not $cur -or $cur.IPAddress -notmatch '^10\.10\.10\.') {
        if ($cur) {
          Remove-NetIPAddress -InterfaceIndex $idx `
            -AddressFamily IPv4 -Confirm:$false `
            -ErrorAction SilentlyContinue
        }
        New-NetIPAddress -InterfaceIndex $idx `
          -AddressFamily IPv4 -IPAddress "10.10.10.10" `
          -PrefixLength 24 | Out-Null
        Write-Host "Lab IP set: 10.10.10.10 on $($adapter.Name)"
      } else {
        Write-Host "Lab IP already set: $($cur.IPAddress)"
      }
    } else {
      Write-Host "WARN: could not find private adapter"
    }
  SHELL

  # ── Provisioning ─────────────────────────────────────────────

  # Wait for WinRM to stabilize after network adapter changes
  config.vm.provision "shell", run: "always", inline: "Start-Sleep -Seconds 10; Write-Host 'WinRM ready'"

  # Installation script
  config.vm.provision "file",
    source:      "scripts/install.ps1",
    destination: "C:\\sslab\\install.ps1"

  # Run the installer
  # To run only specific steps: SS_STEPS="sql_db" vagrant provision
  # Default (empty): runs all steps
  config.vm.provision "shell",
    privileged:  true,
    path:        "scripts/install.ps1",
    powershell_elevated_interactive: false,
    args:        ENV.fetch("SS_STEPS", "")

  # ── Print VM IP at the end of provisioning ───────────────────
  config.vm.provision "shell", run: "always", inline: <<-'SHELL'
    Write-Host ""
    Write-Host "----------------------------------------"
    Write-Host "  Ironhold - Ready"
    Write-Host "----------------------------------------"
    Write-Host "  HTTP:     http://localhost:8080/SecretServer"
    Write-Host "  HTTPS:    https://localhost:8443/SecretServer"
    Write-Host "  Direct:   http://10.10.10.10/SecretServer"
    Write-Host "  Username: admin"
    Write-Host "  Password: Passw0rd!"
    Write-Host "  RDP:      localhost:53389  (vagrant / vagrant)"
    Write-Host "----------------------------------------"
    Write-Host ""
  SHELL

end
